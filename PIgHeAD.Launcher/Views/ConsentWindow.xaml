<Window x:Class="PIgHeAD.Launcher.Views.ConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PIgHeAD.Launcher.Services.Presentation"
        xmlns:ui="clr-namespace:PIgHeAD.Launcher.Services.Presentation"
        Title="{loc:Loc 'PIgHeAD · 用户协议与免责声明'}" Icon="{StaticResource PigBrandImage}"
        Width="850" Height="740" MinWidth="640" MinHeight="560" WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <Button Content="{Binding LanguageSwitchLabel, Source={x:Static ui:PresentationSettings.Current}}"
                    Command="{Binding ToggleLanguageCommand, Source={x:Static ui:PresentationSettings.Current}}"
                    HorizontalAlignment="Right" Padding="12,4" MinHeight="30" ToolTip="切换界面语言 / Switch language"/>
            <TextBlock Text="{loc:Loc '欢迎使用 PIgHeAD'}" Style="{StaticResource PageTitleStyle}"/>
            <TextBlock Text="{loc:Loc '请先阅读用户协议与免责声明（草案） · 发布者 PIgHeAD_OFOG'}" Style="{StaticResource CaptionStyle}"/>
        </StackPanel>
        <TabControl Grid.Row="1" Margin="0,12" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}">
            <TabItem Header="{loc:Loc '用户协议'}"><TextBox Text="{loc:Translate {Binding AgreementText, Mode=OneWay}}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="18" Margin="0"/></TabItem>
            <TabItem Header="{loc:Loc '免责声明与隐私'}"><TextBox Text="{loc:Translate {Binding DisclaimerText, Mode=OneWay}}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="18" Margin="0"/></TabItem>
        </TabControl>
        <StackPanel x:Name="ConsentActions" Grid.Row="2">
            <CheckBox Content="{loc:Loc '我已阅读并同意《PIgHeAD 用户协议（草案）》'}" IsChecked="{Binding AgreementAccepted}" Margin="0,6" Foreground="{DynamicResource TextBrush}"/>
            <CheckBox Content="{loc:Loc '我已阅读并同意《免责声明与隐私说明（草案）》'}" IsChecked="{Binding DisclaimerAccepted}" Margin="0,6" Foreground="{DynamicResource TextBrush}"/>
            <TextBlock Text="{loc:Translate {Binding Status}}" Style="{StaticResource CaptionStyle}" Margin="0,10" AutomationProperties.LiveSetting="Polite"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:Loc '不同意并退出'}" Command="{Binding DeclineCommand}" Margin="0,0,12,0"/>
                <Button Content="{loc:Loc '同意并继续'}" Command="{Binding AcceptCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
