<Window x:Class="PIgHeAD.Launcher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PIgHeAD.Launcher.Services.Presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:PIgHeAD.Launcher.ViewModels"
        xmlns:views="clr-namespace:PIgHeAD.Launcher.Views"
        xmlns:controls="clr-namespace:PIgHeAD.Launcher.Views.Controls"
        xmlns:ui="clr-namespace:PIgHeAD.Launcher.Services.Presentation"
        Title="{loc:Loc 'PIgHeAD - 猪头启动器'}" Icon="{StaticResource PigBrandImage}"
        Style="{StaticResource {x:Type Window}}"
        Width="1180" Height="780" MinWidth="1000" MinHeight="640"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="HandleDragOver" PreviewDrop="HandleDrop" DragLeave="HandleDragLeave"
        controls:InteractionAnimation.AnimationsEnabled="{Binding AnimationsEnabled}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
            <views:VersionsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}">
            <views:DownloadsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
            <views:AccountsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>
    <Grid x:Name="WindowSurface" Background="{DynamicResource BackgroundBrush}" SizeChanged="UpdateWindowClip">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- WindowChrome keeps native drag, resize and caption double-click behavior. -->
        <Border Grid.ColumnSpan="2" Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="22,0,0,0" VerticalAlignment="Center">
                    <Image Source="{StaticResource PigBrandImage}" Width="18" Height="18" Margin="0,0,12,0"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <TextBlock Text="{loc:Translate {Binding Title, RelativeSource={RelativeSource AncestorType=Window}}}"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <TextBlock Text="Minecraft Java Edition" Style="{StaticResource CaptionStyle}" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,20,0" />
                    <Button Command="{Binding ToggleThemeCommand, Source={x:Static ui:PresentationSettings.Current}}"
                            Width="112" Padding="12,4" MinHeight="30" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11">
                        <TextBlock Text="{Binding ThemeSwitchLabel, Source={x:Static ui:PresentationSettings.Current}}" Width="84" TextAlignment="Center" TextWrapping="NoWrap"/>
                    </Button>
                    <Button Command="{Binding ToggleLanguageCommand, Source={x:Static ui:PresentationSettings.Current}}"
                            ToolTip="切换界面语言 / Switch language" AutomationProperties.Name="Switch language"
                            Width="64" Padding="12,4" MinHeight="30" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11">
                        <TextBlock Text="{Binding LanguageSwitchLabel, Source={x:Static ui:PresentationSettings.Current}}" Width="38" TextAlignment="Center" TextWrapping="NoWrap"/>
                    </Button>
                    <Button Style="{StaticResource CaptionButtonStyle}" Click="MinimizeWindow"
                            ToolTip="{loc:Loc '最小化'}" AutomationProperties.Name="{loc:Loc '最小化'}">
                        <Path Data="M0,5 L10,5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" />
                    </Button>
                    <Button Click="ToggleMaximizeWindow" AutomationProperties.Name="{loc:Loc '最大化或还原'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                                <Setter Property="ToolTip" Value="{loc:Loc '最大化'}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="ToolTip" Value="{loc:Loc '还原'}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1" Width="10" Height="10" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Data" Value="M0,0 L10,0 10,10 0,10 Z" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Data" Value="M3,0 L10,0 10,7 M0,3 L7,3 7,10 0,10 Z" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Click="CloseWindow" ToolTip="{loc:Loc '关闭'}" AutomationProperties.Name="{loc:Loc '关闭'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#A83248" />
                                        <Setter Property="Foreground" Value="White" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SidebarBrush}" Padding="16,18,16,14"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,20">
                        <Image Source="{StaticResource PigBrandImage}" Width="40" Height="40" Margin="0,0,12,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="PIgHeAD" FontSize="23" FontWeight="Bold" />
                            <TextBlock Text="{loc:Loc '猪头启动器'}" FontSize="11" Margin="1,3,0,0"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <TextBlock Text="{loc:Translate {Binding VersionDisplay}}" FontSize="10" Margin="1,4,0,0" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" FontSize="10" Margin="16,0,0,14"
                               Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom">
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Fill="{DynamicResource MutedTextBrush}" Width="6" Height="6" Margin="0,0,8,0" />
                                <TextBlock Text="{loc:Translate {Binding Home.AccountName}}" FontSize="12" Width="140"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Text="{loc:Loc '你的冒险，即将开始'}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="10" Margin="14,8,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="JAVA EDITION · PIgHeAD" Foreground="{DynamicResource MutedTextBrush}"
                               FontSize="9" HorizontalAlignment="Center" />
                </StackPanel>
                <ListBox x:Name="PrimaryNavigation" ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavigationItemStyle}"
                         Background="Transparent" BorderThickness="0" Padding="0" SelectionMode="Single"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="{loc:Loc '主导航'}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Style="{StaticResource NavigationIconStyle}" />
                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <TextBlock Text="{loc:Translate {Binding Title}}" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                    <TextBlock Text="{loc:Translate {Binding Subtitle}}" FontSize="10" Margin="0,4,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <controls:AnimatedContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}"
                                        AnimationsEnabled="{Binding AnimationsEnabled}" Margin="24,20,24,16"/>
        <Border x:Name="StartupAnimation" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed"
                Background="{DynamicResource BackgroundBrush}" CornerRadius="16" Panel.ZIndex="10">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="StartupMark" Width="112" Height="112" CornerRadius="28"
                        Background="{DynamicResource AccentTintBrush}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <Image Source="{StaticResource PigBrandImage}" Width="64" Height="64"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <TextBlock Text="PIgHeAD" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,6"/>
                <TextBlock Text="{loc:Loc '给每一次冒险，一个好的开始'}" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Border x:Name="StartupDotOne" Width="7" Height="7" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="4"/>
                    <Border x:Name="StartupDotTwo" Width="7" Height="7" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="4"/>
                    <Border x:Name="StartupDotThree" Width="7" Height="7" CornerRadius="2" Background="{DynamicResource AccentBrush}" Margin="4"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="16" IsHitTestVisible="False" />
    </Grid>
</Window>
