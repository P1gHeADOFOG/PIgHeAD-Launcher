<UserControl x:Class="PIgHeAD.Launcher.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PIgHeAD.Launcher.Services.Presentation">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <TextBlock Text="Home" FontSize="24" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" Margin="0,0,8,0" />
                <TextBlock Text="{loc:Loc '给每一次冒险，一个好的开始'}" FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
                <Border x:Name="HomeHero" CornerRadius="18" Margin="0,0,0,12" MaxHeight="240">
                    <Border.Style><Style TargetType="Border">
                        <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="{StaticResource OverworldArtwork}" Stretch="Fill"/></Setter.Value></Setter>
                        <Style.Triggers><DataTrigger Binding="{Binding Theme, Source={x:Static loc:PresentationSettings.Current}}" Value="Light">
                            <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="{StaticResource OverworldDayArtwork}" Stretch="Fill"/></Setter.Value></Setter>
                        </DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                    <Border CornerRadius="18" Padding="24,12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="{DynamicResource HeroOverlayStart}" Offset="0" />
                                <GradientStop Color="{DynamicResource HeroOverlayMiddle}" Offset="0.34" />
                                <GradientStop Color="#081B242D" Offset="0.82" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left"><StackPanel>
                            <TextBlock Text="{loc:Loc '欢迎回来，冒险家。'}" FontSize="13" Foreground="{DynamicResource HeroSecondaryTextBrush}" />
                            <TextBlock Text="PIgHeAD" Foreground="{DynamicResource HeroTextBrush}" FontSize="36" FontWeight="Bold" Margin="0,7,0,4" />
                            <TextBlock Text="{loc:Loc '猪头启动器 · 下一段冒险，从这里开始。'}" FontSize="13" Foreground="{DynamicResource HeroSecondaryTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Border Background="{DynamicResource SuccessTintBrush}" BorderBrush="{DynamicResource SuccessBrush}"
                                        BorderThickness="1" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="MINECRAFT JAVA EDITION" FontSize="9" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </StackPanel>
                        </StackPanel></Viewbox>
                    </Border>
                </Border>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Margin="0" Padding="18,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource VersionsIcon}" Width="15" Height="15" Stretch="Uniform"
                                          Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Margin="0,0,9,0" />
                                    <TextBlock Text="{loc:Loc '当前游戏版本'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                                </StackPanel>
                                <Border HorizontalAlignment="Right" Background="{DynamicResource SuccessTintBrush}"
                                        CornerRadius="4" Padding="7,3">
                                    <TextBlock Text="JAVA" FontSize="9" Foreground="{DynamicResource SuccessBrush}" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{loc:Translate {Binding SelectedVersion}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{loc:Translate {Binding SelectedVersion}}" FontSize="25" FontWeight="SemiBold"
                                           AutomationProperties.Name="{loc:Loc '当前 Minecraft 版本'}" />
                                <TextBlock Text="{loc:Translate {Binding VersionDescription}}" FontSize="11" Margin="0,4,0,0"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Button Grid.Row="2" Content="{loc:Loc '切换版本  →'}" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding DataContext.ShowVersionsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Left" Margin="0,5,0,0" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0" Padding="18,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource AccountsIcon}" Width="15" Height="15" Stretch="Uniform"
                                      Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Margin="0,0,9,0" />
                                <TextBlock Text="{loc:Loc '游戏账户'}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,10,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource AccentTintBrush}" CornerRadius="10" Width="42" Height="42"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="{StaticResource AccountsIcon}" Stroke="{DynamicResource AccentBrush}"
                                          StrokeThickness="1.5" Width="22" Height="22" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,0,0">
                                    <TextBlock Text="{loc:Translate {Binding AccountName}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{loc:Translate {Binding AccountName}}" FontSize="18" FontWeight="SemiBold"
                                               AutomationProperties.Name="{loc:Loc '登录状态'}" />
                                    <TextBlock Text="{loc:Translate {Binding AccountDescription}}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{loc:Translate {Binding AccountDescription}}" FontSize="11" Margin="0,6,0,0"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                            <Button Grid.Row="2" Content="{loc:Loc '管理账户  →'}" Style="{StaticResource LinkButtonStyle}"
                                    Command="{Binding DataContext.ShowAccountsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Left" Margin="0,5,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{loc:Loc '下一站，方块世界。'}" FontSize="18" FontWeight="SemiBold" />
                            <TextBlock Text="{loc:Loc '准备好，去创造属于你的故事。'}" Foreground="{DynamicResource MutedTextBrush}"
                                       FontSize="11" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{Binding LaunchGameCommand}" Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="200" Height="50" AutomationProperties.Name="Launch Game">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource PlayIcon}" Fill="{DynamicResource AccentTextBrush}"
                                      Width="16" Height="18" Stretch="Uniform" Margin="0,0,13,0" />
                                <TextBlock Text="Launch Game" FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <WrapPanel Grid.Row="3" Margin="2,6,0,0">
                    <CheckBox Content="{loc:Loc '允许下载缺失文件及对应 Java'}" IsChecked="{Binding AllowDownloads}"
                              IsEnabled="{Binding Downloads.IsIdle}"
                              Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                    <Button Content="{loc:Loc '取消准备'}" Command="{Binding LaunchGameCancelCommand}" IsEnabled="{Binding IsPreparing}"
                            Style="{StaticResource LinkButtonStyle}" Margin="20,0,0,0" />
                </WrapPanel>
                <TextBlock Grid.Row="4" Text="{loc:Translate {Binding LaunchNotice}}" Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                           Margin="2,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{loc:Translate {Binding LaunchNotice}}" AutomationProperties.LiveSetting="Polite" />
        </Grid>

        <Border x:Name="HomeStatusArea" Grid.Row="2" Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16,12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                        <Path Data="{StaticResource JavaIcon}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Margin="0,0,7,0" />
                        <TextBlock Text="{loc:Loc 'JAVA 环境'}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{loc:Translate {Binding JavaStatus}}" Style="{StaticResource StatusValueStyle}" ToolTip="{loc:Translate {Binding JavaStatus}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="12,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                        <Path Data="{StaticResource MemoryIcon}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Margin="0,0,7,0" />
                        <TextBlock Text="{loc:Loc '分配内存'}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{loc:Translate {Binding MemorySummary}}" Style="{StaticResource StatusValueStyle}" ToolTip="{loc:Translate {Binding MemorySummary}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                        <Path Data="{StaticResource FolderIcon}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Margin="0,0,7,0" />
                        <TextBlock Text="{loc:Loc '游戏目录'}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{loc:Translate {Binding GameDirectory}}" Style="{StaticResource StatusValueStyle}" ToolTip="{loc:Translate {Binding GameDirectory}}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                        <Path Data="{StaticResource DownloadsIcon}" Width="13" Height="13" Stretch="Uniform"
                              Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="1.5" Margin="0,0,7,0" />
                        <TextBlock Text="{loc:Loc '下载状态'}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                    </StackPanel>
                    <TextBlock Text="{loc:Translate {Binding DownloadStatus}}" Style="{StaticResource StatusValueStyle}" ToolTip="{loc:Translate {Binding DownloadStatus}}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
