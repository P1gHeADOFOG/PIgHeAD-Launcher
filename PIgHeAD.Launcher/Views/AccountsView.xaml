<UserControl x:Class="PIgHeAD.Launcher.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PIgHeAD.Launcher.Services.Presentation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Text="Accounts" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:Loc '选择离线身份，或登录拥有 Minecraft Java 的 Microsoft 账户。'}" Style="{StaticResource CaptionStyle}" />
            <Border Style="{StaticResource CardStyle}" Margin="0,20,0,16">
                <StackPanel>
                    <TextBlock Text="{loc:Translate {Binding DisplayName}}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Text="{loc:Translate {Binding Description}}" Style="{StaticResource CaptionStyle}" />
                    <StackPanel IsEnabled="{Binding CanEdit}">
                        <Label Content="{loc:Loc '离线玩家名'}" Target="{Binding ElementName=OfflineNameInput}" Margin="0,18,0,0" />
                        <TextBox x:Name="OfflineNameInput" Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
                        <TextBlock Text="{loc:Loc '3–16 位英文字母、数字或下划线。离线身份不提供正版服务器认证。'}" Style="{StaticResource CaptionStyle}" FontSize="12" />
                        <CheckBox Content="{loc:Loc '使用 Microsoft 正版身份启动'}" IsChecked="{Binding UseMicrosoft}"
                                  Foreground="{DynamicResource TextBrush}" Margin="0,16,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc 'Microsoft 登录'}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <TextBlock Text="{loc:Translate {Binding ClientIdStatus}}" Style="{StaticResource CaptionStyle}" />
                    <TextBlock Text="{loc:Translate {Binding MinecraftApiStatus}}" Style="{StaticResource CaptionStyle}" FontSize="12" />
                    <TextBlock Text="{loc:Loc '浏览器授权后，还需通过 Xbox 与 Minecraft 验证；请以此处显示的最终结果为准。启动器不收集 Microsoft 密码。'}"
                               Style="{StaticResource CaptionStyle}" FontSize="12" Margin="0,8,0,16" />
                    <WrapPanel>
                        <Button Content="{loc:Loc '登录 Microsoft'}" Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,8" />
                        <Button Content="{loc:Loc '取消登录'}" Command="{Binding SignInCancelCommand}" Margin="0,0,12,8" />
                        <Button Content="{loc:Loc '退出并清除缓存'}" Command="{Binding SignOutCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                    <ProgressBar IsIndeterminate="{Binding IsBusy}" Height="4" Margin="0,12,0,0"
                                 Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource SurfaceBrush}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="{loc:Translate {Binding Status}}" Style="{StaticResource CaptionStyle}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
