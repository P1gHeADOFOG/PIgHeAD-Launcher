<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>0.1.4-beta</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <InformationalVersion>0.1.4beta</InformationalVersion>
    <Product>PIgHeAD - 猪头启动器</Product>
    <ApplicationIcon>Resources\Images\pighead.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="2.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CmlLib.Core" Version="4.1.0" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.4.0" />
    <PackageReference Include="XboxAuthNet.Game.Msal" Version="0.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\docs\User-Agreement.md" LogicalName="PIgHeAD.UserAgreement.md" />
    <EmbeddedResource Include="..\docs\Disclaimer.md" LogicalName="PIgHeAD.Disclaimer.md" />
    <Resource Include="Resources\Images\pighead.png" />
    <Resource Include="Resources\Images\pighead.ico" />
  </ItemGroup>

</Project>
