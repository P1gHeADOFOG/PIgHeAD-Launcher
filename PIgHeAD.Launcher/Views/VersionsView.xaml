<UserControl x:Class="PIgHeAD.Launcher.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:PIgHeAD.Launcher.Services.Presentation">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Versions" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="{loc:Loc '管理本地版本、查看详情与模组；安装新版本请前往下载中心。'}" Style="{StaticResource CaptionStyle}" />
            <TextBlock Text="{loc:Loc '游戏文件夹'}" Margin="0,14,0,6"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc '切换文件夹'}" Command="{Binding SwitchDirectoryCommand}" Margin="12,0,0,0"/>
                <ComboBox ItemsSource="{Binding Settings.GameDirectories}" ItemTemplate="{StaticResource LocalizedDirectoryTemplate}"
                          SelectedItem="{Binding Settings.SelectedGameDirectory, Mode=TwoWay}"
                          IsEnabled="{Binding Settings.CanEdit}" AutomationProperties.Name="{loc:Loc '游戏文件夹列表'}"/>
            </DockPanel>
            <TextBlock Text="{loc:Translate {Binding Settings.GameDataDirectory, StringFormat=数据目录：{0}}}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,12,0,10">
            <Button Content="{loc:Loc '刷新本地版本'}" Command="{Binding RefreshLocalCommand}" Margin="0,0,12,8" />
            <Button Content="{loc:Loc '前往下载中心  →'}" Command="{Binding DataContext.ShowDownloadsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,12,8" />
            <Button Content="{loc:Loc '修复游戏'}" Command="{Binding RepairSelectedCommand}" Margin="0,0,12,8"/>
            <Button Content="{loc:Loc '取消当前操作'}" Command="{Binding DataContext.Downloads.CancelCurrentCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8" />
        </WrapPanel>
        <Border Grid.Row="2" Padding="18" Margin="0,0,0,16" CornerRadius="10" BorderThickness="1">
            <Border.Style><Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsDragOver}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="Background" Value="{DynamicResource ElevatedBrush}"/>
                </DataTrigger></Style.Triggers>
            </Style></Border.Style>
            <StackPanel>
                <TextBlock Text="{loc:Loc '拖入 ZIP / .mrpack 整合包，或包含 .minecraft 的文件夹'}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="{loc:Loc '导入压缩整合包…'}" Command="{Binding ImportArchiveCommand}" Margin="0,0,10,8"/>
                    <Button Content="{loc:Loc '接入游戏目录…'}" Command="{Binding ImportDirectoryCommand}" Margin="0,0,10,8"/>
                    <CheckBox Content="{loc:Loc '导入后校验并补全文件（需要网络）'}" IsChecked="{Binding CompleteImportedFiles}" IsEnabled="{Binding CanImport}" VerticalAlignment="Center" Margin="4,0,0,8"/>
                </WrapPanel>
                <TextBlock Text="{loc:Loc '每次导入一个项目。ZIP 可先跳过补全，稍后修复；.mrpack 需勾选补全并联网安装。压缩包解压到独立目录，目录接入不会移动原文件。'}" Style="{StaticResource CaptionStyle}" FontSize="12"/>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border CornerRadius="14" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <ListBox ItemsSource="{Binding AvailableVersions}"
                 SelectedItem="{Binding SelectedGameVersion, Mode=TwoWay}"
                 IsEnabled="{Binding DataContext.Downloads.IsIdle, RelativeSource={RelativeSource AncestorType=Window}}"
                 Background="Transparent" Foreground="{DynamicResource TextBrush}" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ItemContainerStyle="{StaticResource ContentListItemStyle}" AutomationProperties.Name="{loc:Loc 'Minecraft 版本列表'}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Translate {Binding Id}}" FontSize="17" FontWeight="SemiBold"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                        <TextBlock Text="{loc:Translate {Binding DisplayName}}" Style="{StaticResource CaptionStyle}" FontSize="11" Margin="0,6,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{loc:Loc '详情'}" Padding="10,6" MinHeight="32" Margin="0,0,6,0"
                                Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                        <Button Content="{loc:Loc '删除'}" Padding="10,6" MinHeight="32" Foreground="{DynamicResource ErrorBrush}"
                                Command="{Binding DataContext.RequestDeleteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                    </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
            </Border>
            <Border Grid.Column="1" Width="340" Margin="12,0,0,0" Padding="16" CornerRadius="14"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding HasDetails, Converter={StaticResource BooleanVisibility}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{loc:Loc '返回详情'}" Command="{Binding ReturnToDetailsCommand}" Padding="8,4" MinHeight="30" Margin="0,0,6,0"
                                        Visibility="{Binding IsModsVisible, Converter={StaticResource BooleanVisibility}}"/>
                                <Button Content="{loc:Loc '收起'}" Command="{Binding CloseDetailsCommand}" Padding="8,4" MinHeight="30"/>
                            </StackPanel>
                            <TextBlock FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{loc:Loc '本地版本详情'}"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding IsModsVisible}" Value="True"><Setter Property="Text" Value="{loc:Loc '本地模组'}"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </DockPanel>
                        <TextBlock Text="{Binding Details.VersionId}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Button x:Name="ViewModsEntry" Content="{loc:Loc '查看模组'}" Command="{Binding ViewModsCommand}"
                                HorizontalAlignment="Left" Margin="0,0,0,12">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CanViewMods}" Value="True"/><Condition Binding="{Binding IsModsVisible}" Value="False"/>
                                </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers>
                            </Style></Button.Style>
                        </Button>
                        <StackPanel Visibility="{Binding IsModsVisible, Converter={StaticResource BooleanVisibility}}" Margin="0,0,0,16">
                            <TextBlock Text="{loc:Loc '读取实际运行目录 mods 中的 JAR 资料，不代表模组兼容性验证。'}" Style="{StaticResource CaptionStyle}" FontSize="11"/>
                            <TextBlock Text="{loc:Loc '此目录没有模组文件。'}">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionStyle}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers><DataTrigger Binding="{Binding Mods.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Mods}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Translate {Binding Version}}" FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding ModId}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}"/>
                                        <TextBlock Text="{loc:Translate {Binding MetadataStatus}}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                        <StackPanel DataContext="{Binding Details}">
                            <StackPanel.Style><Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers><DataTrigger Binding="{Binding DataContext.IsModsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style></StackPanel.Style>
                            <TextBlock Text="Minecraft" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{Binding MinecraftVersion}" Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc '模组加载器'}" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{loc:Translate {Binding LoaderSummary}}" Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc 'Java 要求'}" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{loc:Translate {Binding JavaSummary}}" Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc '版本类型'}" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{Binding VersionType}" Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc '发布时间'}" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{loc:Translate {Binding ReleaseSummary}}" Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc '版本目录大小'}" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{Binding SizeSummary}" Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc '版本目录'}" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{Binding VersionDirectory}" FontSize="11" Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc '实际运行目录'}" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{Binding WorkingDirectory}" FontSize="11" Margin="0,0,0,14"/>
                            <TextBlock Text="{loc:Loc '游戏目录'}" Style="{StaticResource StatusLabelStyle}"/><TextBlock Text="{Binding GameDirectory}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock Grid.Row="4" Text="{loc:Translate {Binding Status}}" Style="{StaticResource CaptionStyle}" Margin="0,16,0,0"
                   AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.RowSpan="5" Panel.ZIndex="20" Background="#77000000"
              Visibility="{Binding IsDeleteConfirmationVisible, Converter={StaticResource BooleanVisibility}}">
            <Border Width="520" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="18" Padding="24"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{loc:Loc '确认移入回收站？'}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding Details.VersionId}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock Text="{loc:Loc '仅移动下方版本目录，其中的存档、模组与配置也会随目录移动。共享资源和独立 instances 目录保留。'}" FontSize="13"/>
                    <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="12" Margin="0,14,0,20">
                        <TextBlock Text="{Binding Details.VersionDirectory}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <WrapPanel HorizontalAlignment="Right">
                        <Button Content="{loc:Loc '取消'}" Command="{Binding CancelDeleteCommand}" Padding="16,8" Margin="0,0,10,0"/>
                        <Button Content="{loc:Loc '确认删除'}" Command="{Binding ConfirmDeleteCommand}" Foreground="{DynamicResource ErrorBrush}" Padding="16,8"/>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
