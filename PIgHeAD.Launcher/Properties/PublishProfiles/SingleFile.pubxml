<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' != 'true'">false</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en;zh-Hans;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- The release script prepares original notices before bundling. Keep them
       inside the assembly so the standalone EXE needs no companion files. -->
  <ItemGroup Condition="'$(ReleaseContentDirectory)' != ''">
    <EmbeddedResource Include="$(ReleaseContentDirectory)\ThirdPartyNotices\**\*"
                      LogicalName="PIgHeAD.ThirdPartyNotices.%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(ReleaseContentDirectory)\docs\*.md" WithCulture="false"
                      LogicalName="PIgHeAD.ReleaseDocs.%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(ReleaseContentDirectory)\README.md"
                      LogicalName="PIgHeAD.ReleaseDocs.README.md" />
    <EmbeddedResource Include="$(ReleaseContentDirectory)\README.en.md" WithCulture="false"
                      LogicalName="PIgHeAD.ReleaseDocs.README.en.md" />
    <EmbeddedResource Include="$(ReleaseContentDirectory)\build-info.json"
                      LogicalName="PIgHeAD.ReleaseDocs.build-info.json" />
  </ItemGroup>
</Project>
